<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- Allow HTTPS connections by default -->
  <domain-config cleartextTrafficPermitted="false">
    <!-- Railway domain for HTTPS production backend -->
    <domain includeSubdomains="true">web-production-7be31.up.railway.app</domain>
  </domain-config>
  
  <!-- Allow localhost for local development only if needed -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="true">127.0.0.1</domain>
    <domain includeSubdomains="true">10.0.2.2</domain>
  </domain-config>
</network-security-config>
